<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.assetflow.mapper.AiReportMapper">

    <insert id="insert" parameterType="AiReport" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_reports (user_id, report_text)
        VALUES (#{userId}, #{reportText})
    </insert>

    <select id="findLatestByUserId" resultType="AiReport">
        SELECT id, user_id, report_text, created_at
        FROM ai_reports
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
        LIMIT 1
    </select>

</mapper>
